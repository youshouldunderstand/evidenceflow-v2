APP_NAME=EvidenceFlow
APP_ENV=development
DATABASE_URL=sqlite:///./evidence_flow.db
CHECKPOINT_DATABASE_PATH=./evidence_flow_checkpoints.db

# 通过 OpenAI-compatible API 调用 GLM-5.2。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_MODEL=glm-5.2
OPENAI_MAX_TOKENS=4096
# 非流式深度推理可能超过 60 秒；连接最多等待 10 秒，读取上限可配置为 1–600 秒。
OPENAI_TIMEOUT_SECONDS=180

# 默认使用带明确标记的确定性演示 Provider。
# 配置 OPENAI_API_KEY 后可改为 glm。
LLM_PROVIDER=fake

# 搜索 Provider：fake、tavily 或 google。
# 推荐 Tavily：免费账户每月 1,000 credits，basic 搜索每次消耗 1 credit。
SEARCH_PROVIDER=fake
TAVILY_API_KEY=
TAVILY_SEARCH_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic

# 工作流硬预算；真实 Provider 可按任务规模调高，但不要取消上限。
# glm 原生工具调用的每轮决策、每页证据提取均计费计数。
# 真实任务建议 MODEL_CALLS=14、TOKENS=200000 起步，详见 README。
WORKFLOW_MAX_MODEL_CALLS=8
WORKFLOW_MAX_TOOL_CALLS=30
WORKFLOW_MAX_SEARCH_CALLS=8
WORKFLOW_MAX_PAGES=15
WORKFLOW_MAX_TOKENS=50000
WORKFLOW_MODEL_OUTPUT_RESERVE_TOKENS=4096
# 研究阶段最多使用 4 次模型尝试，并为写作和首次审核预留 2 次／12000 Token。
WORKFLOW_RESEARCH_MAX_MODEL_CALLS=4
WORKFLOW_DOWNSTREAM_RESERVED_MODEL_CALLS=2
WORKFLOW_DOWNSTREAM_RESERVED_TOKENS=12000
WORKFLOW_MAX_NO_PROGRESS_STEPS=2
# 第一次审核后最多补证 1 轮；补证模型额度为 2，并为修订／复审预留 2 次和 8000 Token。
WORKFLOW_MAX_SUPPLEMENT_ROUNDS=1
WORKFLOW_SUPPLEMENT_MAX_MODEL_CALLS=2
WORKFLOW_POST_SUPPLEMENT_RESERVED_MODEL_CALLS=2
WORKFLOW_POST_SUPPLEMENT_RESERVED_TOKENS=8000

# Google 模式只适合已有 Custom Search JSON API 凭据的用户。
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
GOOGLE_SEARCH_NUM_RESULTS=5
# 可选，例如 lang_zh-CN；留空表示不限制语言。
GOOGLE_SEARCH_LANGUAGE=

WORKFLOW_VERSION=v2.0
